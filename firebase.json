{
  "hosting": {
    "site": "bsp-pos",
    "public": "apps/web/out",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "trailingSlash": false,
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(self), geolocation=(), browsing-topics=()"
          },
          {
            "key": "Cross-Origin-Opener-Policy",
            "value": "same-origin-allow-popups"
          }
        ]
      },
      {
        "source": "/pos-sw.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          },
          {
            "key": "Service-Worker-Allowed",
            "value": "/"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/owner/invoices/:id",
        "destination": "/owner/invoice?id=:id",
        "type": 302
      },
      {
        "source": "/staff/invoices/:id",
        "destination": "/staff/invoice?id=:id",
        "type": 302
      },
      {
        "source": "/admin/organizations/:id",
        "destination": "/admin/organization?id=:id",
        "type": 302
      }
    ]
  }
}
