# Backend API (server-only): copy backend values to apps/api/.env.
APP_ENV=development
NODE_ENV=development
PORT=3001
WEB_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:3001

# Target structured database.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=YOUR_TURSO_AUTH_TOKEN

# Firebase Admin SDK. Use workload identity where supported, or provide the
# service-account JSON through your secret manager (never commit the real value).
FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
FIREBASE_SERVICE_ACCOUNT_JSON=

# Cloudflare R2 private backend credentials.
R2_ACCOUNT_ID=YOUR_CLOUDFLARE_ACCOUNT_ID
R2_BUCKET_NAME=YOUR_R2_BUCKET
R2_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY

# Existing Cashfree server-side payment configuration.
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_WEBHOOK_SECRET=
CASHFREE_ENV=sandbox
CASHFREE_RETURN_URL=http://localhost:3001/api/payments/cashfree/return

# Web client (public Firebase config): copy to apps/web/.env.local.
NEXT_PUBLIC_FIREBASE_API_KEY=YOUR_FIREBASE_WEB_API_KEY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=YOUR_FIREBASE_PROJECT_ID.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
NEXT_PUBLIC_FIREBASE_APP_ID=YOUR_FIREBASE_WEB_APP_ID
NEXT_PUBLIC_API_URL=http://localhost:3001

# Optional integrations.
AI_PROVIDER=
AI_PROVIDER_KEY=
AI_PROVIDER_BASE_URL=
AI_PROVIDER_MODEL=
