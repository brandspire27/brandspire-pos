# Firebase API keys are public client configuration; never put server credentials here.
BRANDSPIRE_FIREBASE_API_KEY=YOUR_FIREBASE_WEB_API_KEY

# Android emulator -> Windows host localhost
BRANDSPIRE_API_BASE_URL=http://10.0.2.2:3001
# For a real Android phone on the same Wi-Fi, replace 10.0.2.2 with your computer's LAN IP.
