# Brandspire POS API - STAGING ONLY
APP_ENV=staging
APP_VERSION=0.22.0-staging
APP_RELEASE_SHA=local
PORT=3001

# Use a separate staging Supabase project, not the production database.
SUPABASE_URL=https://YOUR_STAGING_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_STAGING_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_STAGING_SERVICE_ROLE_KEY

# Public staging URLs (HTTPS only)
WEB_URL=https://YOUR-STAGING-WEB.vercel.app
API_PUBLIC_URL=https://YOUR-STAGING-API.example.com

# Cashfree stays sandbox in staging. Leave blank until you are ready to test payments.
CASHFREE_ENV=sandbox
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_RETURN_URL=https://YOUR-STAGING-API.example.com/api/payments/cashfree/return

ANDROID_MIN_VERSION_CODE=4
ANDROID_RECOMMENDED_VERSION_CODE=4
ANDROID_LATEST_VERSION_NAME=0.4.0
ANDROID_UPDATE_URL=

APP_MAINTENANCE_MODE=off
APP_MAINTENANCE_MESSAGE=Brandspire POS staging maintenance.
